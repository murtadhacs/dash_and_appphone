server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # صورة البنر أو ملف الجدول حتى 2 MiB مع هامش 64 KiB لحقول multipart.
    client_max_body_size 2112k;

    # ---------------------------------------------------- تمرير الـ API
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host ${API_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host ${API_HOST};
        proxy_ssl_server_name on;
    }

    # ------------------------------------------------------- الموقع
    # index.html وملف التشغيل بلا تخزين مؤقت، حتى يصل كل إصدار جديد فوراً.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /flutter_service_worker.js {
        add_header Cache-Control "no-cache";
    }

    location ~* \.(wasm)$ {
        types { application/wasm wasm; }
        add_header Cache-Control "public, max-age=604800";
    }

    # تطبيق صفحة واحدة: أي مسار غير موجود يعود إلى index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
